<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.chatoverlaystreaming</groupId>
  <artifactId>chat-overlay-streaming</artifactId>
  <version>1.2</version>
  <build>
    <plugins>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.4.1</version>
        <executions>
          <execution>
            <id>shade-overlay</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.directory}/overlay.jar</outputFile>
              <transformers>
                <transformer>
                  <mainClass>com.chatoverlaystreaming.Main</mainClass>
                </transformer>
                <transformer>
                  <resources>
                    <resource>META-INF/*.SF</resource>
                    <resource>META-INF/*.DSA</resource>
                    <resource>META-INF/*.RSA</resource>
                  </resources>
                </transformer>
              </transformers>
              <excludes>
                <exclude>com/chatoverlaystreaming/Launcher.class</exclude>
                <exclude>com/chatoverlaystreaming/Launcher$*.class</exclude>
              </excludes>
            </configuration>
          </execution>
          <execution>
            <id>shade-launcher</id>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <outputFile>${project.build.directory}/launcher.jar</outputFile>
              <transformers>
                <transformer>
                  <mainClass>com.chatoverlaystreaming.Launcher</mainClass>
                </transformer>
              </transformers>
              <artifactSet>
                <includes>
                  <include>com.chatoverlaystreaming:chat-overlay-streaming</include>
                </includes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>com.chatoverlaystreaming:chat-overlay-streaming</artifact>
                  <includes>
                    <include>com/chatoverlaystreaming/Launcher.class</include>
                    <include>com/chatoverlaystreaming/Launcher$*.class</include>
                  </includes>
                </filter>
              </filters>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.chatoverlaystreaming.Main</mainClass>
            </manifest>
          </archive>
          <finalName>overlay</finalName>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>package</phase>
            <goals>
              <goal>copy-dependencies</goal>
            </goals>
            <configuration>
              <outputDirectory>${project.build.directory}/libs</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>com.chatoverlaystreaming.Main</mainClass>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <properties>
    <maven.compiler.target>21</maven.compiler.target>
    <maven.compiler.source>21</maven.compiler.source>
  </properties>
</project>
