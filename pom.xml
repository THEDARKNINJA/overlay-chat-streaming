<project>
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.chatoverlaystreaming</groupId>
  <artifactId>chat-overlay-streaming</artifactId>
  <version>1.2</version>

  <properties>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
  </properties>

  <dependencies>
    <!-- YouTube Data API v3 -->
    <dependency>
      <groupId>com.google.apis</groupId>
      <artifactId>google-api-services-youtube</artifactId>
      <version>v3-rev20231011-2.0.0</version>
    </dependency>
    <dependency>
      <groupId>com.google.http-client</groupId>
      <artifactId>google-http-client-jackson2</artifactId>
      <version>1.43.3</version>
    </dependency>

    <!-- JNA para APIs nativas de Windows -->
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna</artifactId>
      <version>5.14.0</version>
    </dependency>
    <dependency>
      <groupId>net.java.dev.jna</groupId>
      <artifactId>jna-platform</artifactId>
      <version>5.14.0</version>
    </dependency>

    <!-- JSON -->
    <dependency>
      <groupId>org.json</groupId>
      <artifactId>json</artifactId>
      <version>20231013</version>
    </dependency>

    <!-- JavaFX -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-media</artifactId>
      <version>21</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-swing</artifactId>
      <version>21</version>
    </dependency>

    <!-- vlcj para reproducción de vídeo con VLC -->
    <dependency>
      <groupId>uk.co.caprica</groupId>
      <artifactId>vlcj</artifactId>
      <version>4.8.2</version>
    </dependency>

    <!-- JCEF para el navegador OAuth integrado -->
    <dependency>
      <groupId>me.friwi</groupId>
      <artifactId>jcefmaven</artifactId>
      <version>122.1.10</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>

      <!-- ══════════════════════════════════════════════════════════════════
           maven-shade-plugin
           Genera dos uber-jars en la fase package:
             1. overlay.jar   → ChatOverlay (Main), todas las dependencias
             2. launcher.jar  → Launcher,    solo org.json
           ══════════════════════════════════════════════════════════════════ -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.4.1</version>
        <executions>

          <!-- Ejecución 1: overlay.jar (ChatOverlay completo) -->
          <execution>
            <id>shade-overlay</id>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <outputFile>${project.build.directory}/overlay.jar</outputFile>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.chatoverlaystreaming.Main</mainClass>
                </transformer>
                <!-- Evitar advertencias de firma de JARs firmados (jna, etc.) -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.DontIncludeResourceTransformer">
                  <resources>
                    <resource>META-INF/*.SF</resource>
                    <resource>META-INF/*.DSA</resource>
                    <resource>META-INF/*.RSA</resource>
                  </resources>
                </transformer>
              </transformers>
              <!-- Excluir clases del Launcher del jar de ChatOverlay
                   para mantenerlo lo más pequeño posible -->
              <excludes>
                <exclude>com/chatoverlaystreaming/Launcher.class</exclude>
                <exclude>com/chatoverlaystreaming/Launcher$*.class</exclude>
              </excludes>
              
            </configuration>
          </execution>

          <!-- Ejecución 2: launcher.jar (solo Launcher + org.json) -->
          <execution>
            <id>shade-launcher</id>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <outputFile>${project.build.directory}/launcher.jar</outputFile>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.chatoverlaystreaming.Launcher</mainClass>
                </transformer>
              </transformers>
              <!-- Solo las clases del Launcher, sin dependencias externas -->
              <artifactSet>
                <includes>
                  <include>com.chatoverlaystreaming:chat-overlay-streaming</include>
                </includes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>com.chatoverlaystreaming:chat-overlay-streaming</artifact>
                  <includes>
                    <include>com/chatoverlaystreaming/Launcher.class</include>
                    <include>com/chatoverlaystreaming/Launcher$*.class</include>
                  </includes>
                </filter>
              </filters>
            </configuration>
          </execution>

        </executions>
      </plugin>

      <!-- ══════════════════════════════════════════════════════════════════
           maven-jar-plugin
           El jar por defecto también apunta a Main para compatibilidad
           con ejecución directa desde el IDE.
           ══════════════════════════════════════════════════════════════════ -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.3.0</version>
        <configuration>
          <archive>
            <manifest>
              <mainClass>com.chatoverlaystreaming.Main</mainClass>
            </manifest>
          </archive>
          <finalName>overlay</finalName>
        </configuration>
      </plugin>

      <!-- ══════════════════════════════════════════════════════════════════
           maven-dependency-plugin
           Copia todas las dependencias en target/libs para jpackage.
           ══════════════════════════════════════════════════════════════════ -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>copy-dependencies</id>
            <phase>package</phase>
            <goals><goal>copy-dependencies</goal></goals>
            <configuration>
              <outputDirectory>${project.build.directory}/libs</outputDirectory>
              <includeScope>runtime</includeScope>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- ══════════════════════════════════════════════════════════════════
           javafx-maven-plugin
           Para ejecución desde el IDE con mvn javafx:run
           ══════════════════════════════════════════════════════════════════ -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>com.chatoverlaystreaming.Main</mainClass>
        </configuration>
      </plugin>

    </plugins>
  </build>
</project>